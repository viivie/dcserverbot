# Discord Developer Portal → Bot → Token
# ACLClouds 的「Token Discord」欄位通常會提供 DISCORD_TOKEN。
DISCORD_TOKEN=

# Optional Google Drive backup.
# Put the Google service-account JSON key at credentials/google_drive.json.
# Share this Google Drive folder with the service-account email.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FILENAME=database.db
GOOGLE_DRIVE_BACKUP_INTERVAL=3600
