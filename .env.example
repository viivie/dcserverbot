# Discord Developer Portal → Bot → Token
# ACLClouds 的「Token Discord」欄位通常會提供 DISCORD_TOKEN。
DISCORD_TOKEN=

# Optional: only sync commands to this server. Leave blank to sync every server.
DISCORD_GUILD_ID=
DISCORD_TARGET_USERNAME=ariel970927
# The target user ID is preset in config.py; set this only if it changes.
# DISCORD_TARGET_USER_ID=

# SQLite database. ACLClouds keeps the data folder between restarts.
DATA_FILE=data/worship.sqlite3
