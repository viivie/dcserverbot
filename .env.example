# Discord Developer Portal → Bot → Token
# ACLClouds 的「Token Discord」欄位通常會提供 DISCORD_TOKEN。
DISCORD_TOKEN=

# Optional Google Drive backup.
# OAuth Client JSON defaults to credentials/google_drives.json.
# Override this with an absolute path if the file is stored elsewhere.
# GOOGLE_DRIVE_OAUTH_CLIENT_FILE=credentials/google_drives.json
# OAuth token defaults to google_drive_token.json beside the client JSON.
# GOOGLE_DRIVE_OAUTH_TOKEN_FILE=credentials/google_drive_token.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FILENAME=database.db
GOOGLE_DRIVE_BACKUP_INTERVAL=3600
