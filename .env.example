# Discord Developer Portal → Bot → Token
# ACLClouds 的「Token Discord」欄位通常會提供 DISCORD_TOKEN。
DISCORD_TOKEN=

# Optional: only sync commands to this server. Leave blank to sync every server.
DISCORD_GUILD_ID=
DISCORD_TARGET_USERNAME=ariel970927
# The target user ID is preset in config.py; set this only if it changes.
# DISCORD_TARGET_USER_ID=

# Optional Google Drive backup.
# Use a service-account JSON object on one line, or its Base64 encoding.
GOOGLE_DRIVE_KEY=
# Share this Google Drive folder with the service-account email.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FILENAME=database.db
GOOGLE_DRIVE_BACKUP_INTERVAL=3600
